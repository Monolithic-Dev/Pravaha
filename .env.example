# Names only — never commit real values (hackathon rule + docs/SECURITY.md). Copy to .env.local.

# Cloudinary — account on the DEFAULT (US) region: transcription is unavailable on Asia-Pacific
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=pravaha_signed
# Public trials at /try: their preset (pnpm preset:trial keeps the first 60 s) and a daily cap; 0 turns trials off
CLOUDINARY_TRIAL_PRESET=pravaha_trial
TRIALS_PER_DAY=5
# Read-only demo Studio for visitors without the passcode: on | off
STUDIO_DEMO=on
# Optional: who may frame /embed/ask (a frame-ancestors source list; default any HTTPS page). docs/EMBED.md
EMBED_FRAME_ANCESTORS=

# Neon Postgres — pooled connection string
DATABASE_URL=

# Google Gemini — Ask and Study Packs (docs/AI_EVALUATION.md). Optional: without it Ask shows relevant clips.
GEMINI_API_KEY=
# Optional comma-separated model chain (default in src/lib/ai.ts)
GEMINI_MODELS=
# Optional backup: Groq (console.groq.com), tried when every Gemini model fails. Either key alone is enough.
GROQ_API_KEY=

# Organizer access (docs/SECURITY.md) — passcode >= 24 random chars; secret = openssl rand -base64 32
ORGANIZER_PASSCODE=
SESSION_SECRET=

# Public base URL, used for Cloudinary's notification_url (the Vercel production URL once deployed)
APP_URL=http://localhost:3000
